{
  "name": "mooapp-packages",
  "version": "5.2.0",
  "description": "A collection of packages for the MooApp framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "moo-ds",
    "moo-app",
    "moo-icons",
    "demoo",
    "storybook"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rollup-plugin-peer-deps-external": "^2.2.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "rollup": "^4.62.4",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.28.1",
    "@rollup/rollup-linux-arm64-gnu": "4.62.3"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "scripts": {
    "postinstall": "node scripts/link-eslint-typescript.mjs",
    "demoo": "npm run dev --workspace=demoo",
    "start": "npm run dev --workspace=demoo",
    "storybook": "npm run storybook --workspace=storybook",
    "build": "npm run build --workspace=moo-icons --workspace=moo-ds --workspace=moo-app --workspace=demoo --workspace=storybook",
    "prelint": "node scripts/link-eslint-typescript.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "prelint-fix": "node scripts/link-eslint-typescript.mjs",
    "lint-fix": "npm run lint-fix --workspaces --if-present",
    "type-check": "node node_modules/typescript/bin/tsc -p moo-ds/tsconfig.json && node node_modules/typescript/bin/tsc -p moo-app/tsconfig.json && node node_modules/typescript/bin/tsc -p moo-icons/tsconfig.json && node node_modules/typescript/bin/tsc -p demoo/tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
