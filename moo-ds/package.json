    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./css": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "author": {
    "name": "Andrew McLachlan",
    "url": "https://andrewmclachlan.com"
  },
  "license": "MIT",
