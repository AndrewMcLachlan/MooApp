  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewMcLachlan/MooApp.git"
  },
  "publishConfig": {
    "@andrewmclachlan:registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.3",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
